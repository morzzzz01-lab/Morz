{%- comment -%} Social links from Theme settings → Social media. Only filled-in links are shown. {%- endcomment -%}
{%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_pinterest != blank or settings.social_x != blank -%}
