{%- if shop.enabled_payment_types.size > 0 -%}
  <ul class="pay" role="list" aria-label="{{ 'general.payment_methods' | t }}">
    {%- for type in shop.enabled_payment_types -%}
      <li><span class="pay-vh">{{ type | replace: '_', ' ' | capitalize }}</span>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
