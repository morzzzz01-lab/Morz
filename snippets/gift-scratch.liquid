{%- comment -%}
  Gift scratch card: a floating gift button that opens a scratch-to-reveal
  discount card. Renders only when enabled and a discount code is set in
  Theme settings > Gift scratch card. The code must exist in Shopify admin
  (Discounts) or checkout will reject it.
{%- endcomment -%}
{%- if settings.gift_enable and settings.gift_code != blank -%}
<style>
.gs-fab{position:fixed;right:.9rem;bottom:calc(.9rem + env(safe-area-inset-bottom,0px));z-index:70;width:3.4rem;height:3.4rem;border-radius:50%;border:0;cursor:pointer;font-size:1.7rem;line-height:1;background:linear-gradient(135deg,#c8202f,#8b0f1c);color:#fff;box-shadow:0 8px 24px #c8202f66;animation:gs-wig 3s ease-in-out infinite}
.gs-fab:hover{transform:scale(1.08)}
.gs-fab .gs-dot{position:absolute;top:.1rem;right:.1rem;width:.8rem;height:.8rem;border-radius:50%;background:#ffd23f;border:2px solid #000}
.gs-fab.seen .gs-dot{display:none}
.gs-fab[data-left]::after{content:attr(data-left);position:absolute;bottom:-.55rem;left:50%;translate:-50% 0;white-space:nowrap;font:800 .68rem/1 ui-monospace,monospace;background:#000;border:1px solid #c8202f;padding:.2rem .35rem;border-radius:999px}
@keyframes gs-wig{0%,86%,100%{rotate:0deg}89%{rotate:-14deg}92%{rotate:12deg}95%{rotate:-8deg}}
@media (prefers-reduced-motion:reduce){.gs-fab{animation:none}}
.gs-ov{position:fixed;inset:0;z-index:9000;display:none;place-items:center;padding:1rem;background:#000b;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.gs-ov.open{display:grid}
.gs-box{position:relative;width:min(100%,22rem);background:var(--panel,#0c0f14);border:1px solid var(--line,#1d2530);border-radius:1.1rem;padding:1.6rem 1.3rem 1.3rem;text-align:center;color:var(--ink,#f4f6fa);animation:gs-pop .35s cubic-bezier(.2,.9,.3,1.3)}
@keyframes gs-pop{from{transform:scale(.85);opacity:0}}
.gs-x{position:absolute;top:.5rem;right:.6rem;background:none;border:0;color:var(--muted,#98a2b3);font-size:1.6rem;cursor:pointer;line-height:1}
.gs-box h2{margin:0 0 .3rem;font-size:1.4rem}
.gs-box p{margin:0 0 1rem;color:var(--muted,#98a2b3);font-size:.92rem}
.gs-card{position:relative;height:9.5rem;border-radius:.8rem;overflow:hidden;background:linear-gradient(135deg,#ffb400,#c8202f);display:grid;place-content:center;gap:.3rem;color:#fff;user-select:none}
.gs-card b{font-size:2.1rem;line-height:1}
.gs-card code{font:800 1.15rem/1 ui-monospace,monospace;letter-spacing:.12em;background:#0006;padding:.45rem .8rem;border-radius:.4rem}
.gs-card canvas{position:absolute;inset:0;width:100%;height:100%;cursor:grab;touch-action:none;transition:opacity .5s}
.gs-timer{font:800 .95rem/1 ui-monospace,monospace;background:#000a;padding:.35rem .7rem;border-radius:999px;justify-self:center}
.gs-card.exp b,.gs-card.exp code{opacity:.35;text-decoration:line-through}
.gs-card.exp .gs-timer{background:#000;color:#ff6b6b}
.gs-acts{display:none;gap:.5rem;margin-top:1rem}
.gs-acts.on{display:flex}
.gs-acts>*{flex:1;text-align:center;padding:.75rem .5rem;border-radius:.5rem;font-weight:800;border:1px solid var(--line,#1d2530);background:none;color:inherit;cursor:pointer;text-decoration:none;font-family:inherit;font-size:.9rem}
.gs-acts a{background:var(--blue,#2d8cff);border-color:var(--blue,#2d8cff);color:#fff}
</style>

<button type="button" class="gs-fab" data-gs-open aria-label="{{ settings.gift_title | escape }}">🎁<span class="gs-dot"></span></button>

<div class="gs-ov" data-gs-ov role="dialog" aria-modal="true" aria-labelledby="GsTitle">
  <div class="gs-box">
    <button type="button" class="gs-x" data-gs-close aria-label="Close">×</button>
    <h2 id="GsTitle">{{ settings.gift_title }}</h2>
    <p data-gs-hint>{{ settings.gift_text }}</p>
    <div class="gs-card">
      <b>{{ settings.gift_amount }}</b>
      <code data-gs-code>{{ settings.gift_code | escape }}</code>
      <span class="gs-timer" data-gs-timer hidden></span>
      <canvas data-gs-canvas aria-hidden="true"></canvas>
    </div>
    <div class="gs-acts" data-gs-acts>
      <button type="button" data-gs-copy>{{ settings.gift_copy_label }}</button>
      <a href="{{ routes.all_products_collection_url }}">{{ settings.gift_shop_label }}</a>
    </div>
  </div>
</div>

<script>
(function(){
  var KEY='morz_gift_'+{{ settings.gift_code | json }};
  var fab=document.querySelector('[data-gs-open]'),ov=document.querySelector('[data-gs-ov]'),
      cv=document.querySelector('[data-gs-canvas]'),acts=document.querySelector('[data-gs-acts]'),
      ctx=cv.getContext('2d'),drawn=false,done=false,down=false;
  function store(k,v){try{v===undefined?v=localStorage.getItem(k):localStorage.setItem(k,v)}catch(e){}return v}
  var MS={{ settings.gift_minutes | default: 10 }}*60000,card=document.querySelector('.gs-card'),
      tm=document.querySelector('[data-gs-timer]'),hint=document.querySelector('[data-gs-hint]'),tick;
  var st=store(KEY)||'',t0=st.indexOf('r:')===0?+st.slice(2):0;
  if(t0){done=true}
  if(st)fab.classList.add('seen');
  function left(){return t0+MS-Date.now()}
  function expire(){
    clearInterval(tick);card.classList.add('exp');acts.classList.remove('on');
    document.querySelector('[data-gs-code]').textContent='••••••';
    tm.hidden=false;tm.textContent={{ settings.gift_expired_label | json }};
    hint.textContent={{ settings.gift_expired_text | json }};fab.style.display='none';
  }
  function run(){
    clearInterval(tick);tm.hidden=false;
    (tick=setInterval(function f(){
      var s=Math.ceil(left()/1000);
      if(s<=0)return expire();
      tm.textContent='⏳ '+Math.floor(s/60)+':'+('0'+s%60).slice(-2);
      fab.setAttribute('data-left',tm.textContent);return f;
    }(),1000));
  }
  if(t0&&left()<=0){expire();fab.style.display='none'}else if(t0){run()}

  function paint(){
    var r=cv.getBoundingClientRect(),d=window.devicePixelRatio||1;
    cv.width=r.width*d;cv.height=r.height*d;ctx.scale(d,d);
    var g=ctx.createLinearGradient(0,0,r.width,r.height);
    g.addColorStop(0,'#c9d1dc');g.addColorStop(.5,'#eef2f7');g.addColorStop(1,'#a9b3c1');
    ctx.fillStyle=g;ctx.fillRect(0,0,r.width,r.height);
    ctx.fillStyle='#5b6676';ctx.font='800 17px Manrope,Arial,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText({{ settings.gift_scratch_label | json }},r.width/2,r.height/2);
    ctx.globalCompositeOperation='destination-out';drawn=true;
  }
  function reveal(){
    if(done&&cv.style.display==='none')return;
    done=true;cv.style.opacity='0';setTimeout(function(){cv.style.display='none'},500);
    acts.classList.add('on');t0=Date.now();store(KEY,'r:'+t0);run();
  }
  function pct(){
    var px=ctx.getImageData(0,0,cv.width,cv.height).data,n=0,t=0;
    for(var i=3;i<px.length;i+=64){t++;if(px[i]===0)n++}
    return n/t;
  }
  function scratch(e){
    if(!down||done)return;
    var r=cv.getBoundingClientRect();
    ctx.beginPath();ctx.arc(e.clientX-r.left,e.clientY-r.top,20,0,Math.PI*2);ctx.fill();
    if(pct()>.45)reveal();
  }
  cv.addEventListener('pointerdown',function(e){down=true;cv.setPointerCapture(e.pointerId);scratch(e)});
  cv.addEventListener('pointermove',scratch);
  cv.addEventListener('pointerup',function(){down=false});
  cv.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' ')reveal()});

  function open(){
    ov.classList.add('open');fab.classList.add('seen');
    if(!store(KEY))store(KEY,'seen');
    if(done){cv.style.display='none';if(left()>0)acts.classList.add('on')}
    else if(!drawn)paint();
  }
  function close(){ov.classList.remove('open')}
  fab.addEventListener('click',open);
  ov.addEventListener('click',function(e){if(e.target===ov||e.target.closest('[data-gs-close]'))close()});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')close()});

  document.querySelector('[data-gs-copy]').addEventListener('click',function(){
    var b=this,c=document.querySelector('[data-gs-code]').textContent;
    (navigator.clipboard?navigator.clipboard.writeText(c):Promise.reject()).then(function(){
      b.textContent={{ settings.gift_copied_label | json }};
    },function(){prompt('',c)});
  });

  var delay={{ settings.gift_delay | default: 0 }};
  if(delay>0&&!store(KEY)&&!/\/(cart|checkout)/.test(location.pathname)){
    setTimeout(function(){if(!store(KEY))open()},delay*1000);
  }
})();
</script>
{%- endif -%}
