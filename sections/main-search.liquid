{%- paginate search.results by 24 -%}
<section>
  <div class="wrap">
    <h1 class="ptitle">{{ 'search.title' | t }}</h1>
    <form class="search-page-form" action="{{ routes.search_url }}" method="get" role="search">
      <input class="search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <button class="btn" type="submit">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="muted">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="prods">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, index: forloop.index %}
            {%- else -%}
              <div class="p"><h3><a href="{{ item.url }}">{{ item.title }}</a></h3></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a class="cartb" href="{{ paginate.previous.url }}">&larr; {{ 'collection.previous' | t }}</a>{%- endif -%}
            <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a class="cartb" href="{{ paginate.next.url }}">{{ 'collection.next' | t }} &rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="none">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="none">{{ 'search.prompt' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Search page" }
{% endschema %}
