{%- paginate collection.products by 24 -%}
<section class="collection-sec">
  <div class="wrap">
    <h1 class="ptitle">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte muted">{{ collection.description }}</div>
    {%- endif -%}

    <form class="filters glass" method="get" id="CollectionFilters">
      {%- if collection.filters.size > 0 -%}
        {%- for filter in collection.filters -%}
          <fieldset class="fgroup">
            <legend>{{ filter.label }}</legend>
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                <div class="price-range">
                  <label>{{ 'collection.price_from' | t }}
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}" min="0" placeholder="0" inputmode="decimal">
                  </label>
                  <label>{{ 'collection.price_to' | t }}
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}" min="0" placeholder="{{ filter.range_max | divided_by: 100 }}" inputmode="decimal">
                  </label>
                </div>
              {%- else -%}
                <div class="chips">
                  {%- for value in filter.values -%}
                    <label class="chip">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      <span>{{ value.label }} <small>({{ value.count }})</small></span>
                    </label>
                  {%- endfor -%}
                </div>
            {%- endcase -%}
          </fieldset>
        {%- endfor -%}
      {%- endif -%}

      <div class="sortrow">
        <label for="SortBy">{{ 'collection.sort' | t }}</label>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <select id="SortBy" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
        <button class="btn" type="submit">{{ 'collection.apply' | t }}</button>
        {%- if collection.filters.size > 0 -%}
          <a class="clear" href="{{ collection.url }}">{{ 'collection.clear' | t }}</a>
        {%- endif -%}
      </div>
    </form>

    {%- if collection.products.size > 0 -%}
      <div class="prods">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="cartb" href="{{ paginate.previous.url }}">&larr; {{ 'collection.previous' | t }}</a>{%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="cartb" href="{{ paginate.next.url }}">{{ 'collection.next' | t }} &rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="none">{{ 'collection.no_products' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Collection page" }
{% endschema %}
