{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="product-page" data-product>
  <div class="wrap pg">
    <div class="gallery" data-gallery>
      {%- for media in product.media -%}
        {%- assign media_alt = media.alt | default: product.title -%}
        <div class="g-item" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- if forloop.first -%}{{ media | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 56rem) 50vw, 94vw', loading: 'eager', fetchpriority: 'high', alt: media_alt }}{%- else -%}{{ media | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 56rem) 50vw, 94vw', loading: 'lazy', alt: media_alt }}{%- endif -%}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, image_size: '1200x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="g-item">{{ 'product-1' | placeholder_svg_tag: 'ph-svg' }}</div>
      {%- endfor -%}
    </div>

    <div class="pinfo">
      {%- if section.settings.show_vendor and product.vendor != blank -%}<p class="vendor">{{ product.vendor }}</p>{%- endif -%}
      <h1 class="ptitle">{{ product.title }}</h1>
      <p class="pp">
        <s class="was" data-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        <span data-price>{{ current_variant.price | money }}</span>
        {%- if settings.show_currency_code -%}<small class="cur">{{ cart.currency.iso_code }}</small>{%- endif -%}
      </p>

      {%- form 'product', product, class: 'pform', data-product-form: 'true', data-ptitle: product.title, data-phandle: product.handle -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="opt" data-option-index="{{ forloop.index0 }}">
              <legend>{{ option.name }}</legend>
              <div class="chips">
                {%- for value in option.values -%}
                  <label class="chip">
                    <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="buy-row">
          <label class="visually-hidden" for="qty-{{ section.id }}">{{ 'cart.quantity' | t }}</label>
          <input class="qty-input" id="qty-{{ section.id }}" type="number" name="quantity" value="1" min="1">
          <a class="btn btn-buy btn-card" href="#" data-card-link hidden></a>
          <button class="btn btn-buy btn-card" type="button" data-checkout-btn hidden>{{ 'products.buy_now' | t }}</button>
          <button class="btn btn-cart" type="submit" name="add" data-add-btn aria-label="{{ 'products.add' | t }}" title="{{ 'products.add' | t }}">
            <svg class="cart-ico" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.6 12.2a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.6-1.2L21 8H6"/></svg>
            <span class="cart-txt" data-cart-label>{{ 'products.add' | t }}</span>
          </button>
        </div>
        {% render 'plug-notice', product: product %}
        <div class="bundles" data-bundles hidden></div>
        <p class="card-note" data-card-note hidden><strong>Check your colour &amp; size.</strong> Card checkout is for 1 item of the style you picked (<b data-card-sel></b>). At checkout you will need to enter your colour and size again. Want 2 or more, or different styles? <span data-note-more>Use the cart button.</span></p>
        <p class="form-error" data-form-error role="alert" hidden></p>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="rte desc">{{ product.description }}</div>
      {%- endif -%}

      <p class="policy-links">
        {%- if shop.shipping_policy.body != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ 'products.shipping_policy' | t }}</a>{%- endif -%}
        {%- if shop.refund_policy.body != blank -%}<a href="{{ shop.refund_policy.url }}">{{ 'products.refund_policy' | t }}</a>{%- endif -%}
      </p>
      {% render 'secure-note' %}
      {% render 'payment-icons' %}
    </div>
  </div>

  <script type="application/json" data-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ true | json }},"media":{{ v.featured_media.id | json }},"price":{{ v.price | money | json }},"compare":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  </script>
  <script type="application/ld+json">{{ product | structured_data }}</script>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show brand", "default": true }
  ]
}
{% endschema %}
