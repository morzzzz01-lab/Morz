<section>
  <div class="wrap narrow center">
    <h1 class="ptitle">{{ shop.name }}</h1>
    <p class="lead">{{ 'general.password_title' | t }}</p>
    {%- if shop.password_message != blank -%}<div class="rte muted">{{ shop.password_message }}</div>{%- endif -%}
    {%- form 'storefront_password' -%}
      <h2 class="small-h">{{ 'general.password_enter' | t }}</h2>
      {%- if form.errors -%}<p class="form-error" role="alert">{{ 'general.password_error' | t }}</p>{%- endif -%}
      <div class="search-page-form">
        <input class="search" type="password" name="password" autocomplete="current-password" aria-label="{{ 'general.password_label' | t }}" placeholder="{{ 'general.password_label' | t }}">
        <button class="btn" type="submit">{{ 'general.password_submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password page" }
{% endschema %}
