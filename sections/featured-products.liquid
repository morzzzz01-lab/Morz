{%- assign col = section.settings.collection -%}
{%- if col == blank -%}{%- assign col = collections['all'] -%}{%- endif -%}
<section id="shop">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if col.products.size > 0 -%}
      <div class="prods">
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <p class="view-all"><a class="btn" href="{{ col.url }}">{{ 'general.view_all' | t }}</a></p>
      {%- endif -%}
    {%- else -%}
      <p class="none">{{ 'collection.no_products' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 50, "step": 1, "default": 15 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” button", "default": true }
  ],
  "presets": [ { "name": "Products" } ]
}
{% endschema %}
