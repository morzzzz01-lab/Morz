<section>
  <div class="wrap narrow">
    <h1 class="ptitle">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
    {%- if page.handle contains 'contact' -%}
      {% render 'contact-form', id: section.id %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Page" }
{% endschema %}
