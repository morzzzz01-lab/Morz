<footer>
  <div class="wrap">
    <div>
      <span class="xm-logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: height: 200 | image_tag: class: 'mark', alt: shop.name, loading: 'lazy' }}
      {%- else -%}
        <img class="mark mark--xm" src="{{ 'morz-logo-mini-light.png' | asset_url }}" alt="{{ shop.name | escape }}" width="38" height="50" loading="lazy">
      {%- endif -%}
      </span>
      {%- if section.settings.line_1 != blank -%}<p>{{ section.settings.line_1 }}</p>{%- endif -%}
      {%- if section.settings.line_2 != blank -%}<p>{{ section.settings.line_2 }}</p>{%- endif -%}
    </div>

  </div>

  <div class="wrap foot-bottom">
    {%- assign info_menu = linklists[section.settings.info_menu] -%}
    <nav class="policies" aria-label="Footer">
      {%- if info_menu.links.size > 0 -%}
        {%- for link in info_menu.links -%}{%- if link.type == 'catalog_link' or link.title == 'Catalog' -%}{%- continue -%}{%- endif -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- else -%}
        {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}
      {%- endif -%}
    </nav>
    {%- if section.settings.show_payment_icons -%}{% render 'secure-note' %}{% render 'payment-icons' %}{%- endif -%}
    <p class="copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "line_1", "label": "Line 1", "default": "" },
    { "type": "text", "id": "line_2", "label": "Line 2", "default": "Gifts that glow for everyone on your list." },
    { "type": "link_list", "id": "info_menu", "label": "Policy / info menu", "info": "If empty, your store policies (refund, shipping, privacy, terms) are shown automatically." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true, "info": "Icons come from the payment methods that are actually enabled in your store." }
  ]
}
{% endschema %}
