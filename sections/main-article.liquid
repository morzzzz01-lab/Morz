<article>
  <div class="wrap narrow">
    <h1 class="ptitle">{{ article.title }}</h1>
    <p class="muted small">
      {{ article.published_at | time_tag: format: 'date' }}
      {%- if article.author != blank %} &middot; {{ 'blog.by' | t: author: article.author }}{% endif -%}
    </p>
    {%- if article.image -%}
      {{ article.image | image_url: width: 1200 | image_tag: class: 'cover', loading: 'eager', alt: article.title }}
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
