{%- assign brand_name = settings.brand_name | default: shop.name -%}
<section class="xm-banner" id="xmas">
  <div class="xm-orns" aria-hidden="true">
    <span class="o o1"></span><span class="o o2"></span><span class="o o3"></span><span class="o o4"></span>
  </div>
  <div class="wrap">
    <span class="xm-logo xm-logo--big">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: alt: brand_name, loading: 'lazy' }}
      {%- else -%}
        <img class="mark--xm" src="{{ 'morz-logo-mini-light.png' | asset_url }}" alt="{{ settings.brand_name | default: shop.name | escape }}" width="308" height="404" loading="lazy">
      {%- endif -%}
    </span>
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn" href="{{ section.settings.button_link | default: '#best-sellers' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Christmas banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Merry Christmas from MORZ" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Wrap up something warm, bright and a little bit magical." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the gifts" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to scroll to the products." }
  ],
  "presets": [ { "name": "Christmas banner" } ]
}
{% endschema %}
