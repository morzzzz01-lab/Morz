<section id="welcome" class="wo-sec">
  <div class="wrap">
    <div class="wo">
      <div class="wo-text">
        {%- if section.settings.eyebrow != blank -%}<span class="wo-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      {%- if section.settings.show_signup -%}
        {%- form 'customer', class: 'wo-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, welcome-offer">
          <label class="wo-vh" for="WO-{{ section.id }}">Email</label>
          <input id="WO-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="you@email.com" value="{{ form.email }}">
          <button class="btn" type="submit">{{ section.settings.button_label }}</button>
          {%- if form.posted_successfully? -%}<p class="wo-ok" role="status">{{ section.settings.success_text }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="wo-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Welcome offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "New here?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the MORZ list" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be the first to hear about new drops and sale alerts." },
    { "type": "checkbox", "id": "show_signup", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "button_label", "label": "Sign-up button", "default": "Join" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for joining!" }
  ],
  "presets": [ { "name": "Welcome offer" } ]
}
{% endschema %}
