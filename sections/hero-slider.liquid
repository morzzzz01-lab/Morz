{%- liquid
  assign hero_products = blank
  if section.settings.source == 'new'
    assign hero_products = collections['all'].products | sort: 'created_at' | reverse
  else
    assign hero_col = section.settings.collection
    if hero_col == blank
      assign hero_col = collections['best-sellers']
    endif
    if hero_col == blank or hero_col.products.size == 0
      assign hero_col = collections['all']
    endif
    assign hero_products = hero_col.products
  endif
  assign auto = false
  if section.settings.auto_products and hero_products != blank and hero_products.size > 0
    assign auto = true
  endif
  assign total = section.blocks.size
  if auto and hero_products.size < total
    assign total = hero_products.size
  endif
  if section.settings.auto_color
    assign d_c1 = '#262626'
    assign d_c2 = '#060606'
    assign d_fg = '#ffffff'
    assign d_fgi = '#111111'
    assign d_accent = '#d9d9d9'
    assign d_bg = '#050505'
    assign d_panel = '#101010'
    assign d_line = '#262626'
  endif
  assign first = section.blocks.first
  assign first_word = first.settings.word
  if auto and first.settings.product == blank
    assign first_word = hero_products.first.title | truncatewords: 2, '' | upcase
  endif
-%}
{%- if section.settings.shift_theme and first != blank -%}
  <style>:root{--blue:{{ d_accent | default: first.settings.accent }};--bg:{{ d_bg | default: first.settings.bg }};--panel:{{ d_panel | default: first.settings.panel }};--line:{{ d_line | default: first.settings.line }};}</style>
{%- endif -%}

<div class="hs" id="top" data-hero data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" data-theme="{{ section.settings.shift_theme }}" data-autocolor="{{ section.settings.auto_color }}"
  {%- if first != blank %} style="--c1:{{ d_c1 | default: first.settings.c1 }};--c2:{{ d_c2 | default: first.settings.c2 }};--fg:{{ d_fg | default: first.settings.fg }};--fgi:{{ d_fgi | default: first.settings.fgi }}"{% endif %}>
  <div class="wrap hg">
    <div class="ht">
      <h1>{{ section.settings.heading }} <em>{{ section.settings.subheading }}</em></h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="stage" data-stage>
      <div class="wpar"><div class="word" data-word>{{ first_word }}</div></div>
      <div class="par" data-magnet>
        {%- for block in section.blocks limit: total -%}
          {%- liquid
            assign product = block.settings.product
            assign auto_slide = false
            if product == blank and auto
              assign product = hero_products[forloop.index0]
              assign auto_slide = true
            endif
            assign img = block.settings.image
            if img == blank and product != blank
              assign img = product.featured_image
            endif
            assign word_text = block.settings.word
            assign alt_text = block.settings.title | default: product.title
            if auto_slide
              assign word_text = product.title | truncatewords: 2, '' | upcase
              assign alt_text = product.title
            endif
            assign demo_file = 'shoe-' | append: forloop.index | append: '.webp'
            assign brand_hex = ''
            if product != blank
              for tg in product.tags
                assign tg_l = tg | downcase | remove: ' '
                if tg_l contains 'color:'
                  assign brand_hex = tg_l | split: ':' | last | remove: '#'
                endif
              endfor
            endif
          -%}
          <div class="fl" data-slide="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}
            data-word="{{ word_text | escape }}"{% if brand_hex != blank %} data-brand="#{{ brand_hex }}"{% endif %} data-c1="{{ d_c1 | default: block.settings.c1 }}" data-c2="{{ d_c2 | default: block.settings.c2 }}" data-fg="{{ d_fg | default: block.settings.fg }}" data-fgi="{{ d_fgi | default: block.settings.fgi }}"
            data-accent="{{ d_accent | default: block.settings.accent }}" data-bg="{{ d_bg | default: block.settings.bg }}" data-panel="{{ d_panel | default: block.settings.panel }}" data-line="{{ d_line | default: block.settings.line }}" {{ block.shopify_attributes }}>
            {%- if img != blank -%}
              {{ img | image_url: width: 1000 | image_tag: class: 'shoe', crossorigin: 'anonymous', widths: '400, 600, 800, 1000', sizes: '(min-width: 56rem) 55vw, 92vw', loading: 'eager', alt: alt_text }}
            {%- else -%}
              <img class="shoe" src="{{ demo_file | asset_url }}" alt="{{ block.settings.title | escape }}" width="800" height="600" loading="eager">
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="info">
      {%- for block in section.blocks limit: total -%}
        {%- liquid
          assign product = block.settings.product
          assign auto_slide = false
          if product == blank and auto
            assign product = hero_products[forloop.index0]
            assign auto_slide = true
          endif
        -%}
        <div data-slide-info="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
          <h2>{% if auto_slide %}{% render 'short-title', title: product.title %}{% else %}{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}{% render 'short-title', title: product.title %}{% endif %}{% endif %}</h2>
          <div class="hpr">
            {%- if product != blank -%}{{ product.price | money }}{%- else -%}{{ block.settings.price }}{%- endif -%}
          </div>

          {%- if product != blank and product.variants.size > 1 and product.variants.size <= 6 -%}
            <div class="chips" role="group" aria-label="{{ 'products.size' | t }}">
              {%- for variant in product.variants -%}
                <button type="button" data-size-chip data-variant-id="{{ variant.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {% unless true %}disabled{% endunless %}>{{ variant.title }}</button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="hbtns">
            {%- if product != blank and product.variants.size <= 6 -%}
              {%- assign vid = product.selected_or_first_available_variant.id -%}
              <button type="button" class="btn" data-add-to-cart data-variant-id="{{ vid }}">{{ 'products.add' | t }}</button>
            {%- elsif product != blank -%}
              <a class="btn" href="{{ product.url }}">{{ 'products.choose_options' | t }}</a>
            {%- endif -%}
            <a class="btn ghost" href="{% if product != blank %}{{ product.url }}{% else %}{{ section.settings.button_link | default: routes.all_products_collection_url }}{% endif %}">{{ section.settings.button_label }}</a>
          </div>
        </div>
      {%- endfor -%}

      {%- if total > 1 -%}
        <div class="nav2">
          <button type="button" data-prev aria-label="Previous">&#8249;</button>
          <div class="dots-wrap">
            {%- for block in section.blocks limit: total -%}<i data-dot="{{ forloop.index0 }}" class="{% if forloop.first %}on{% endif %}"></i>{%- endfor -%}
          </div>
          <button type="button" data-next aria-label="Next">&#8250;</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero slider",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Merry Christmas." },
    { "type": "text", "id": "subheading", "label": "Sub-heading", "default": "It’s a lifestyle." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Music boxes, trains and cozy lights for everyone on your list." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link (used when a slide has no product)" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "source", "label": "Products shown", "default": "new", "options": [ { "value": "new", "label": "Newest products (added automatically)" }, { "value": "collection", "label": "Products of a collection (best sellers)" } ] },
    { "type": "checkbox", "id": "auto_products", "label": "Show real best-selling products", "default": true, "info": "Slides without a chosen product take the next product from the collection below. Colours come from each slide." },
    { "type": "collection", "id": "collection", "label": "Collection (only when “Products shown” = collection)", "info": "Use a collection sorted by “Best selling”. If empty, the collection with handle “best-sellers” is used, otherwise all products." },
    { "type": "checkbox", "id": "auto_color", "label": "Pick colours automatically from each product image", "default": true, "info": "The gradient and the whole store theme take the colour of the product that is showing. Turn off to use the manual colours in each slide." },
    { "type": "checkbox", "id": "shift_theme", "label": "Change store accent colours with each slide", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Title, price, sizes and Add to cart come from this product." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Defaults to the product's main image. Transparent PNG/WebP works best." },
        { "type": "text", "id": "title", "label": "Title override", "info": "Optional when a product is selected." },
        { "type": "text", "id": "price", "label": "Price text", "info": "Only shown when no product is selected." },
        { "type": "text", "id": "word", "label": "Big background word", "default": "COURT GOLD" },
        { "type": "header", "content": "Colours" },
        { "type": "color", "id": "c1", "label": "Gradient start", "default": "#ffb400" },
        { "type": "color", "id": "c2", "label": "Gradient end", "default": "#a85d00" },
        { "type": "color", "id": "fg", "label": "Text on gradient", "default": "#111111" },
        { "type": "color", "id": "fgi", "label": "Text on buttons", "default": "#ffffff" },
        { "type": "color", "id": "accent", "label": "Store accent", "default": "#ffb400" },
        { "type": "color", "id": "bg", "label": "Store background", "default": "#0a0700" },
        { "type": "color", "id": "panel", "label": "Store panels", "default": "#151008" },
        { "type": "color", "id": "line", "label": "Store borders", "default": "#2e2410" }
      ]
    }
  ],
  "presets": [
    { "name": "Hero slider", "blocks": [ { "type": "slide" } ] }
  ]
}
{% endschema %}
