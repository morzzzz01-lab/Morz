<section {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead }}</p>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text block",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "about" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our vision" },
    { "type": "textarea", "id": "lead", "label": "Large text", "default": "MORZ brings warm, bright Christmas gifts together in one place." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Find something a little bit magical with MORZ.</p>" }
  ],
  "presets": [ { "name": "Text block" } ]
}
{% endschema %}
