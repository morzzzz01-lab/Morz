<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if request.locale.iso_code contains 'ar' or request.locale.iso_code contains 'he' %} dir="rtl"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name | escape }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    :root{--bg:{{ settings.color_bg }};--panel:{{ settings.color_panel }};--line:{{ settings.color_line }};--ink:{{ settings.color_text }};--muted:{{ settings.color_muted }};--blue:{{ settings.color_accent }};}
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="tpl-password">
  <main>{{ content_for_layout }}</main>
</body>
</html>
