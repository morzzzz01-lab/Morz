[
  {
    "name": "theme_info",
    "theme_name": "MORZ Christmas",
    "theme_version": "1.0.0",
    "theme_author": "MORZ",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#07130c"
      },
      {
        "type": "color",
        "id": "color_panel",
        "label": "Panels",
        "default": "#0f2216"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#25402c"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#fff8ee"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#b8c9bb"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#e63946"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to use the built-in MORZ logo (with the elf hat)."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Header logo height",
        "min": 28,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 44
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Use cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_currency_code",
        "label": "Show currency code on prices",
        "default": false
      }
    ]
  },
  {
    "name": "Gift scratch card",
    "settings": [
      {
        "type": "paragraph",
        "content": "A gift button that opens a scratch card with a discount code. After it is scratched, a countdown starts; when it ends the code is hidden. Payments go through Whop, so create the code in Whop (Promo codes) with the same name. Leave the code empty to hide the gift."
      },
      {
        "type": "checkbox",
        "id": "gift_enable",
        "label": "Show gift scratch card",
        "default": true
      },
      {
        "type": "text",
        "id": "gift_code",
        "label": "Discount code",
        "info": "Must match a Whop promo code exactly"
      },
      {
        "type": "text",
        "id": "gift_amount",
        "label": "Prize text",
        "default": "10% OFF"
      },
      {
        "type": "text",
        "id": "gift_title",
        "label": "Title",
        "default": "A gift for you 🎁"
      },
      {
        "type": "text",
        "id": "gift_text",
        "label": "Text",
        "default": "Scratch the card. The code works for 10 minutes — paste it at card checkout."
      },
      {
        "type": "text",
        "id": "gift_scratch_label",
        "label": "Text on scratch layer",
        "default": "Scratch here ✨"
      },
      {
        "type": "text",
        "id": "gift_copy_label",
        "label": "Copy button",
        "default": "Copy code"
      },
      {
        "type": "text",
        "id": "gift_copied_label",
        "label": "Copied message",
        "default": "Copied ✓"
      },
      {
        "type": "text",
        "id": "gift_shop_label",
        "label": "Shop button",
        "default": "Shop now"
      },
      {
        "type": "range",
        "id": "gift_minutes",
        "label": "Code visible for",
        "min": 1,
        "max": 60,
        "step": 1,
        "unit": "min",
        "default": 10
      },
      {
        "type": "text",
        "id": "gift_expired_label",
        "label": "Timer ended label",
        "default": "Expired"
      },
      {
        "type": "text",
        "id": "gift_expired_text",
        "label": "Timer ended text",
        "default": "Sorry, the time is up. Watch for the next gift!"
      },
      {
        "type": "range",
        "id": "gift_delay",
        "label": "Open automatically after",
        "info": "0 = only when the gift button is clicked. Opens once per visitor.",
        "min": 0,
        "max": 60,
        "step": 5,
        "unit": "s",
        "default": 15
      }
    ]
  }
]
