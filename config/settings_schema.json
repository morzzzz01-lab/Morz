[
  {
    "name": "theme_info",
    "theme_name": "MORZ Christmas",
    "theme_version": "1.0.0",
    "theme_author": "MORZ",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#07130c"
      },
      {
        "type": "color",
        "id": "color_panel",
        "label": "Panels",
        "default": "#0f2216"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#25402c"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#fff8ee"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#b8c9bb"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#e63946"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "MORZ",
        "info": "Written the same way everywhere on the site (logo text, footer, page titles). Leave empty to use the store name."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to use the built-in MORZ logo (with the elf hat)."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Header logo height",
        "min": 28,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 44
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Use cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_currency_code",
        "label": "Show currency code on prices",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Paste full links (https://...). Only filled-in links are shown in the footer."
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "placeholder": "https://instagram.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "placeholder": "https://facebook.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "placeholder": "https://tiktok.com/@yourshop"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X (Twitter)"
      }
    ]
  },
  {
    "name": "Electrical products",
    "settings": [
      {
        "type": "checkbox",
        "id": "plug_notice",
        "label": "Show plug / voltage warning on electrical products",
        "default": true
      },
      {
        "type": "text",
        "id": "plug_keywords",
        "label": "Detect by words in title, tags or options",
        "default": "US Plug,Heated,Electric,110V",
        "info": "Comma separated. A product tagged \"electric\" always shows the warning."
      },
      {
        "type": "textarea",
        "id": "plug_text",
        "label": "Warning text",
        "default": "Electrical item with a US plug (110–120V). For 220–240V countries (Mongolia, Europe, Asia) use a voltage converter of at least the product's wattage — a plug adapter alone is not enough and can damage the item."
      }
    ]
  }
]
