[
  {
    "name": "theme_info",
    "theme_name": "MORZ Christmas",
    "theme_version": "1.0.0",
    "theme_author": "MORZ",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#07130c"
      },
      {
        "type": "color",
        "id": "color_panel",
        "label": "Panels",
        "default": "#0f2216"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#25402c"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#fff8ee"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#b8c9bb"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#e63946"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to use the built-in MORZ logo (with the elf hat)."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Header logo height",
        "min": 28,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 44
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Use cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_currency_code",
        "label": "Show currency code on prices",
        "default": false
      }
    ]
  }
]