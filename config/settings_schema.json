[
  {
    "name": "theme_info",
    "theme_name": "MORZ Christmas",
    "theme_version": "1.0.0",
    "theme_author": "MORZ",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#07130c"
      },
      {
        "type": "color",
        "id": "color_panel",
        "label": "Panels",
        "default": "#0f2216"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#25402c"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#fff8ee"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#b8c9bb"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#e63946"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to use the built-in MORZ logo (with the elf hat)."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Header logo height",
        "min": 28,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 44
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Use cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_currency_code",
        "label": "Show currency code on prices",
        "default": false
      }
    ]
  },
  {
    "name": "Gift scratch card",
    "settings": [
      {
        "type": "paragraph",
        "content": "Visitors enter their email and get a personal Whop promo code (letters and digits) by email, then scratch a card on the site to open it. The code stops working after 10 minutes. One gift per email; emails are checked and saved in Whop. Codes are made and emailed by the Cloudflare worker below."
      },
      {
        "type": "checkbox",
        "id": "gift_enable",
        "label": "Show gift scratch card",
        "default": true
      },
      {
        "type": "text",
        "id": "gift_endpoint",
        "label": "Gift server address",
        "default": "https://morz-whop-shopify-sync.morz.workers.dev/gift"
      },
      {
        "type": "text",
        "id": "gift_title",
        "label": "Title",
        "default": "A secret gift for you"
      },
      {
        "type": "textarea",
        "id": "gift_text",
        "label": "Text",
        "default": "Enter your email and we will send you a personal discount code for anything in the store."
      },
      {
        "type": "range",
        "id": "gift_delay",
        "label": "Open by itself this long after the loading screen",
        "info": "0 = right away. Opens once per visit until the visitor has a code.",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "s",
        "default": 0
      }
    ]
  }
]
